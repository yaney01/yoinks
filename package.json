{
  "name": "yoinks",
  "version": "0.3.2",
  "description": "Download videos, audio, images, galleries, and mixed-media posts from your terminal with yt-dlp and gallery-dl.",
  "type": "module",
  "bin": {
    "yoinks": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "check": "npm test && npm run typecheck && npm run build",
    "prepublishOnly": "npm run check"
  },
  "author": "Pablo Stanley",
  "contributors": [
    "yaney01"
  ],
  "keywords": [
    "video",
    "image",
    "gallery",
    "downloader",
    "yt-dlp",
    "gallery-dl",
    "youtube",
    "instagram",
    "twitter",
    "threads",
    "cli",
    "tui",
    "ink"
  ],
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ink": "^7.1.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaney01/yoinks.git"
  },
  "homepage": "https://github.com/yaney01/yoinks#readme",
  "bugs": {
    "url": "https://github.com/yaney01/yoinks/issues"
  }
}
